<UserControl x:Class="MnemoCalendar.Views.UserControls.Clock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MnemoCalendar.Views.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="300">
    <Grid>
        <TextBlock Style="{StaticResource NormalTextStyle}"
           VerticalAlignment="Top" HorizontalAlignment="Left"
           Text="{Binding Greeting}"
           Margin="20,10,20,0"/>
        <TextBlock Style="{StaticResource NormalTextStyle}"
           FontSize="40"
           Text="{Binding CurrentTime, StringFormat='{}{0:HH:mm:ss}'}"
           VerticalAlignment="Top" HorizontalAlignment="Left"
           Margin="20,40,20,20"/>
        <TextBlock Style="{StaticResource NormalTextStyle}"
           Text="{Binding CurrentTime, StringFormat='{}{0:dddd, MMM dd, yyyy}', ConverterCulture='en-US'}"
           VerticalAlignment="Top" HorizontalAlignment="Left"
           Margin="20,100,20,0"/>
        <Border Width="50" Height="50"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,15,0">
            <Border.Background>
                <ImageBrush ImageSource="{Binding TimeIconPath}" Stretch="UniformToFill" />
            </Border.Background>
        </Border>
    </Grid>
</UserControl>
