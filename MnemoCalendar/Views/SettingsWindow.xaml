<Window x:Class="MnemoCalendar.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:usercontrols="clr-namespace:MnemoCalendar.Views.UserControls"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        xmlns:local="clr-namespace:MnemoCalendar.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterOwner"
        Title="Settings" Height="450" Width="700">
    <Window.Resources>
        <Style x:Key="SidebarRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="8,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="RootBorder" 
                        Background="{TemplateBinding Background}" 
                        CornerRadius="6">
                            <Grid>
                                <Border x:Name="Indicator"
                                Width="3" Height="18"
                                CornerRadius="2"
                                Background="{StaticResource SecondaryColor}"
                                HorizontalAlignment="Left"
                                Visibility="Collapsed" />

                                <ContentPresenter VerticalAlignment="Center" Margin="14,0" />
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#2A2A2A" />
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#333333" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    <DockPanel Background="{DynamicResource BackgroundColor}"
               LastChildFill="True">
        <Grid DockPanel.Dock="Top" Height="60" Background="{DynamicResource TopBarGradientBackground}">
            <Border Width="30" Height="30" CornerRadius="5"
                    VerticalAlignment="Center" HorizontalAlignment="Left"
                    Margin="20,0,0,0">
                <Border.Background>
                    <ImageBrush ImageSource="/Assets/Media/icon.png" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
            <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="55,15,0,0">
                <TextBlock Style="{StaticResource NormalTextStyle}"
                           HorizontalAlignment="Left"
                           FontSize="12"
                           Text="Mnemo Calendar"/>
                <TextBlock Style="{StaticResource DescriptionTextStyle}"
                           Foreground="Gray"
                           HorizontalAlignment="Left"
                           Text="Version 1.0.0"/>
            </StackPanel>
            <usercontrols:SearchBar DockPanel.Dock="Top" x:Name="SettingsSearchBar"
                                    VerticalAlignment="Top" HorizontalAlignment="Right"
                                    Width="500"/>
        </Grid>
        <Grid DockPanel.Dock="Left" Background="{DynamicResource LeftMenuGradientBackground}">
            <StackPanel Width="200">
                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" 
                             GroupName="SettingsMenu"
                             IsChecked="True"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="Theme">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Brightness6" 
                                                    Width="20" Height="20"
                                                    Margin="0,0,10,0"/>
                        <TextBlock Text="Theme" FontSize="14" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" 
             GroupName="SettingsMenu"
             IsChecked="False"
             Command="{Binding NavigateCommand}"
             CommandParameter="Language">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="Translate" 
                                    Width="20" Height="20"
                                    Margin="0,0,10,0"/>
                        <TextBlock Text="Language" FontSize="14" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" 
             GroupName="SettingsMenu"
             IsChecked="False"
             Command="{Binding NavigateCommand}"
             CommandParameter="Notification">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="BellRingOutline" 
                                    Width="20" Height="20"
                                    Margin="0,0,10,0"/>
                        <TextBlock Text="Notifications" FontSize="14" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" 
             GroupName="SettingsMenu"
             IsChecked="False"
             Command="{Binding NavigateCommand}"
             CommandParameter="Data">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="DatabaseCogOutline" 
                                    Width="20" Height="20"
                                    Margin="0,0,10,0"/>
                        <TextBlock Text="Data" FontSize="14" />
                    </StackPanel>
                </RadioButton>

                <RadioButton Style="{StaticResource SidebarRadioButtonStyle}" 
                             GroupName="SettingsMenu"
                             IsChecked="False"
                             Command="{Binding NavigateCommand}"
                             CommandParameter="About">
                    <StackPanel Orientation="Horizontal">
                        <iconPacks:PackIconMaterial Kind="InformationOutline"
                                    Width="20" Height="20"
                                    Margin="0,0,10,0"/>
                        <TextBlock Text="About" FontSize="14" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Grid>
        <Grid>
            <ContentControl Content="ContentControl"
                            VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>
    </DockPanel>
</Window>
